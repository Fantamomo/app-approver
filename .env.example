# Slack Bot Approver - Environment Configuration

# Server Settings
SERVER_PORT=80
SERVER_HOST=0.0.0.0

# Database Settings
POSTGRES_DB=bot_approver
POSTGRES_USER=bot_approver
POSTGRES_PASSWORD=secretpassword
POSTGRES_PORT=5432
# If connecting to an external database, override POSTGRES_URL directly:
# POSTGRES_URL=r2dbc:postgresql://host:5432/database

# Slack Credentials
SLACK_BOT_TOKEN=
SLACK_USER_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_TOKEN=
SLACK_SESSION_COOKIE=

# Slack Channels
SLACK_CHANNEL_REVIEW=C12345678
SLACK_CHANNEL_LOG=C87654321

# Bot Options
SOCKET_MODE=false
ADMIN_USERS=U12345678,U87654321
SLACK_SLASH_COMMAND=/app-approver
